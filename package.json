{
  "name": "astroadmin",
  "version": "1.11.0",
  "description": "The git-native CMS for Astro — auto-generates an editing UI from your content collection Zod schemas; publish = git push",
  "type": "module",
  "main": "server/index.js",
  "exports": {
    ".": "./server/index.js",
    "./integration": "./integration/index.js",
    "./loader": "./loader/index.js",
    "./components/CmsImage.astro": "./components/CmsImage.astro",
    "./components/CmsVideo.astro": "./components/CmsVideo.astro"
  },
  "bin": {
    "astroadmin": "bin/cli.js"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch bin/cli.js dev",
    "prod": "NODE_ENV=production bun bin/cli.js dev",
    "start": "bun bin/cli.js dev",
    "build:css": "tailwindcss -i ./ui/input.css -o ./ui/styles.css --minify",
    "watch:css": "tailwindcss -i ./ui/input.css -o ./ui/styles.css --watch",
    "test": "bun tests/run-unit.js",
    "test:unit": "bun tests/run-unit.js",
    "test:db": "rm -rf /tmp/aa-unit-cs /tmp/aa-unit-loader; mkdir -p /tmp/aa-unit-cs /tmp/aa-unit-loader; ASTROADMIN_PROJECT_ROOT=/tmp/aa-unit-cs ASTROADMIN_DB=/tmp/aa-unit-cs/content.db bun tests/content-store.test.js && ASTROADMIN_PROJECT_ROOT=/tmp/aa-unit-loader ASTROADMIN_DB=/tmp/aa-unit-loader/content.db bun tests/loader.test.js && bun tests/schema-parser-db.test.js"
  },
  "keywords": [
    "astro",
    "cms",
    "content-collections",
    "admin",
    "zod",
    "headless-cms",
    "git-based-cms",
    "markdown"
  ],
  "author": "James Pickard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudshipco/astroadmin.git"
  },
  "homepage": "https://astroadmin.dev",
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "alpinejs": "^3.15.2",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "esbuild": "^0.24.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "gray-matter": "^4.0.3",
    "multer": "^2.4.0",
    "picomatch": "^4.0.7",
    "simple-git": "^4.0.2",
    "tinyglobby": "^0.2.17",
    "ws": "^8.18.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "peerDependencies": {
    "astro": ">=6.0.0",
    "zod": ">=3.20.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": false
    },
    "zod": {
      "optional": false
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17"
  },
  "files": [
    "bin/",
    "server/",
    "ui/",
    "loader/index.js",
    "loader/open-db.js",
    "integration/index.js",
    "integration/preview-route.astro",
    "components/CmsImage.astro",
    "components/CmsVideo.astro",
    "components/cms-video-client.js",
    "components/site-files.js",
    "README.md",
    "LICENSE"
  ]
}
