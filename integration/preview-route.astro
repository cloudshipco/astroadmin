---
/**
 * AstroAdmin Component Preview Route
 *
 * Renders a block component in isolation for previewing non-page collection items.
 * Uses import.meta.glob to dynamically discover block components from the site.
 *
 * Route: /component-preview/[block]/[...slug]
 * Example: /component-preview/testimonials/sue-altarelli
 *          /component-preview/featuredquotes/sue?field=testimonialIds
 *
 * The convention:
 * - The component is the file in src/components/blocks/ whose name, less a
 *   `Block` suffix, matches the block type ignoring case and punctuation:
 *   `team` -> TeamBlock.astro (or Team.astro); `featured-quotes` ->
 *   FeaturedQuotesBlock.astro. A *Block.astro file wins over a plain one.
 * - It receives a synthetic block `{ type, <field>: [ids] }` both as the
 *   `block` prop and spread as props (so `const { teamIds } = Astro.props`
 *   works as well as `Astro.props.block.teamIds`), with `index` 0.
 * - <field> is `?field=` when given (the editor knows the block field that
 *   refers to the collection), else the type made singular plus `Ids`
 *   (`testimonials` -> `testimonialIds`, `team` -> `teamIds`).
 * - The site's src/styles/global.css is loaded when it exists; nothing else is
 *   assumed about the site's styles.
 */

// Server-render this route (can't enumerate all possible preview paths)
export const prerender = false;

// The site's global styles, when it has that file. A glob, not an import, so a
// site without it still gets the preview (an import 500s the route).
import.meta.glob('/src/styles/global.css', { eager: true });

// Get route params
const { block, slug } = Astro.params;

// Parse slug (might be several ids, slash-separated)
const slugs = slug?.split('/').filter(Boolean) || [];

// Dynamically discover block components from the site
// Use Vite's glob import - the leading slash means project root
const blockModules = import.meta.glob('/src/components/blocks/*.astro', { eager: true });

/** `FeaturedQuotesBlock`, `featured-quotes`, `featuredQuotes` -> `featuredquotes`. */
function normaliseType(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]/g, '');
}

/** @type {Record<string, any>} */
const blockComponents: Record<string, any> = {};
const fromBlockSuffix = new Set<string>();

for (const [modulePath, moduleExports] of Object.entries(blockModules)) {
  const filename = modulePath.split('/').pop()?.replace(/\.astro$/, '') || '';
  const hasSuffix = /Block$/i.test(filename);
  const blockType = normaliseType(filename.replace(/Block$/i, ''));
  // TeamBlock.astro wins over Team.astro.
  if (blockComponents[blockType] && fromBlockSuffix.has(blockType) && !hasSuffix) continue;
  blockComponents[blockType] = (moduleExports as any).default;
  if (hasSuffix) fromBlockSuffix.add(blockType);
}

// Build synthetic block data for the component
function buildSyntheticBlock(blockType: string, ids: string[], field: string | null) {
  // Convert plural block type to singular field name
  // testimonials -> testimonialIds, team -> teamIds
  const singular = blockType.endsWith('s') ? blockType.slice(0, -1) : blockType;
  const fieldName = field && /^[A-Za-z_$][\w$]*$/.test(field) ? field : `${singular}Ids`;

  return {
    type: blockType,
    [fieldName]: ids,
  };
}

const field = Astro.url.searchParams.get('field');
const syntheticBlock = buildSyntheticBlock(block || '', slugs, field);
const Component = block ? blockComponents[normaliseType(block)] : null;

// Generate expected component path for error message
const expectedPath = block
  ? `src/components/blocks/${block.charAt(0).toUpperCase() + block.slice(1)}Block.astro`
  : 'unknown';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Preview: {block}</title>
  <style>
    .component-preview-error {
      padding: 2rem;
      text-align: center;
      color: #666;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .component-preview-error code {
      display: block;
      margin-top: 0.5rem;
      padding: 0.5rem 1rem;
      background: #f3f4f6;
      border-radius: 0.375rem;
      font-size: 0.875rem;
    }
    .component-preview-error p {
      margin: 0.5rem 0;
    }
  </style>
</head>
<body>
  <main>
    {Component ? (
      <Component {...syntheticBlock} block={syntheticBlock} index={0} />
    ) : (
      <div class="component-preview-error">
        <p>No component found for block type: <strong>{block}</strong></p>
        <p>Expected:</p>
        <code>{expectedPath}</code>
        <p style="margin-top: 1rem; font-size: 0.875rem;">
          Available blocks: {Object.keys(blockComponents).join(', ') || 'none found'}
        </p>
      </div>
    )}
  </main>
  <script>
    // Immediately mark all animated elements as visible (no need to wait for scroll)
    document.querySelectorAll('.animate-stagger, .animate-fade-up, .animate-scale-in')
      .forEach(el => el.classList.add('is-visible'));
  </script>
</body>
</html>
