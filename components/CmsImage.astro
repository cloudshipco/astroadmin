---
/**
 * CmsImage: renders a CMS image string (a `/images/...` path that a plain
 * z.string() image field stores) through Astro's image pipeline, so visitors
 * get resized AVIF/WebP variants instead of the uploaded original.
 *
 * Requires Astro >= 7 (Vite 8, for the glob's `caseSensitive` option) and a
 * `sharp` >= 0.35.4 in the SITE's own dependencies: `astro build` loads the
 * site's sharp, not Astro's nested one, and earlier versions are open to the
 * AVIF advisory GHSA-26w7-cxv4-gfx2. See docs/optimised-images.md.
 *
 * - `/images/<path>` resolves by exact path to the key `/public/images/<path>`
 *   of a root-absolute LAZY glob (Vite resolves it against the consuming
 *   site's root, even from inside node_modules). Only the entries actually
 *   rendered are imported. Extensions match in any case (`.JPG`).
 * - Found: <Picture> with AVIF/WebP sources (WebP only in dev; see
 *   SOURCE_FORMATS), an explicit fallback format and
 *   width cap, widths capped at the original's width (and at the largest
 *   candidate width), and a required `sizes`.
 * - External URLs, SVG and GIF: a plain <img>. Every plain <img> (these and
 *   the dev original below) has a local path served under the site's `base`
 *   (`/blog/images/...` with `base: '/blog'`), as public files are; an
 *   external URL is used as it is. (Astro's own URLs carry the base already.)
 * - A local raster path with no glob entry:
 *     build: an error naming the content value;
 *     dev:   (`astro dev`, by MODE; see IS_ASTRO_DEV) if the file exists
 *            under the site's public/ (site-files.js), a plain <img> of the original,
 *            marked data-cms-image="dev-original" (Vite re-reads the glob only
 *            on a restart or a file event, which `server.hmr: false` turns
 *            off, so a fresh upload is not in it yet); otherwise the error.
 * - Empty: nothing.
 * - Quality: every generated variant (AVIF, WebP and a JPEG or WebP
 *   fallback) is encoded at `quality`, default 80. Astro's Sharp service
 *   passes no quality when none is given, and Sharp's own AVIF default is 50,
 *   which visibly smooths photo texture; WebP and JPEG already default to 80.
 *   The default is skipped (Sharp's defaults apply, as before) when the site
 *   sets a quality in `image.service.config` for any format, so the site's
 *   setting is not overridden, and when `fallbackFormat` is 'png', because a
 *   PNG quality below 100 makes Sharp quantise the fallback to a palette.
 * - Focal point (#82): a point the admin stored for a local path in
 *   `public/images/.metadata.json` (site-files.js `imageMetadata`) becomes
 *   `object-position: <x>% <y>%` on the <img>, merged AFTER the site's own
 *   `style` (a string gets `; object-position: ...` appended; an object gets
 *   an `object-position` key, replacing its own `objectPosition`), in every
 *   local branch: the <picture>'s <img>, an SVG or GIF, the dev original.
 *   `focalPoint={false}` opts a slot out. An external URL reads no metadata.
 *   With no point stored the markup is byte-identical to before: `style`
 *   is left in `rest` untouched.
 * - Crop (#82): a stored crop is passed to <Picture> as `crop`, which the
 *   `astroadmin/image-service` applies (rotate, extract, then the usual
 *   resize); `widths`, `width` and `height` are computed from the cropped
 *   pixel size (`cropPixels`, the service's own rounding), and the focal
 *   point is translated into the crop frame (clamped). A BUILD with a crop
 *   stored and another image service configured fails with an error naming
 *   the image and the setting (an ignored crop would ship the uncropped
 *   photo without a word); in dev the crop is skipped instead, the point
 *   staying in the original's frame, so the preview still renders. A plain
 *   <img> (SVG, GIF, the dev original) cannot crop: the point only.
 * Every other attribute (data-aa-field, loading, fetchpriority, priority,
 * class...) is forwarded to the <img> in every branch.
 */
import { Picture, imageConfig } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { existsInPublic, imageMetadata, withBase } from './site-files.js';
import { cropPixels } from './image-service.js';

interface Props {
  src?: string;
  alt?: string;
  /** The slot's real rendered width, e.g. "(min-width: 1024px) 480px, 100vw". Required. */
  sizes: string;
  /**
   * Candidate widths. Those at or above the original's width are dropped; the
   * original's width is added when it is no wider than the largest candidate,
   * so a huge upload stops at the largest candidate instead of shipping
   * variants at its full width.
   */
  widths?: number[];
  /** Format of the <img> fallback. */
  fallbackFormat?: 'jpg' | 'webp' | 'png';
  /** Largest width the fallback <img> is generated at. */
  fallbackMaxWidth?: number;
  /**
   * Encoder quality for every variant: 1-100, or Astro's presets
   * ('low' 25, 'mid' 50, 'high' 80, 'max' 100). Default 80; see the header
   * for when no default is applied.
   */
  quality?: number | 'low' | 'mid' | 'high' | 'max';
  /** Apply the focal point the admin stored for this image as object-position. Default true. */
  focalPoint?: boolean;
  /** The <img>'s style; a stored focal point is merged after it. */
  style?: string | Record<string, unknown>;
  [attr: string]: unknown;
}

const {
  src = '',
  alt = '',
  sizes,
  widths: candidateWidths = [400, 640, 800, 1024, 1280, 1600, 2048, 2560],
  fallbackFormat = 'jpg',
  fallbackMaxWidth = 1600,
  quality: qualityProp,
  focalPoint: applyFocalPoint = true,
  ...rest
} = Astro.props;

const DEFAULT_QUALITY = 80;
/** The image service that applies a crop; package.json exports it at this name. */
const CROP_SERVICE = 'astroadmin/image-service';
/**
 * In `astro dev`, Astro's /_image endpoint encodes each variant on request,
 * with no cache. Measured on a 2-CPU host: one 1280w variant of a 2 MB PNG
 * took 20.1 s as AVIF (q80), 0.64 s as WebP and 0.22 s as JPEG, so a preview
 * page took 30+ s. Dev therefore serves WebP only; the build keeps AVIF.
 *
 * Gated on MODE, not DEV: Astro (7.3.8, measured) derives DEV from NODE_ENV,
 * not from the command. `astro build` under NODE_ENV=test or development
 * (CI, a developer's shell, `bun test`) has DEV=true with MODE 'production',
 * and `astro dev` under NODE_ENV=production has DEV=false. MODE is
 * 'development' in `astro dev` whatever NODE_ENV says.
 */
const IS_ASTRO_DEV = import.meta.env.MODE === 'development';
const SOURCE_FORMATS: ('avif' | 'webp')[] = IS_ASTRO_DEV ? ['webp'] : ['avif', 'webp'];
/** Sharp encoder options a site may set: `image.service.config.<format>`. */
const siteEncoderConfig = (imageConfig.service?.config ?? {}) as Record<string, { quality?: unknown } | undefined>;
const siteSetsQuality = ['avif', 'webp', 'jpeg', 'png'].some(
  (format) => siteEncoderConfig[format]?.quality !== undefined,
);
const quality =
  qualityProp ?? (siteSetsQuality || fallbackFormat === 'png' ? undefined : DEFAULT_QUALITY);

if (!sizes) {
  throw new Error(`CmsImage: the "sizes" prop is required (image "${src}").`);
}

const PUBLIC_IMAGES = import.meta.glob<{ default: ImageMetadata }>(
  '/public/images/**/*.{jpg,jpeg,png,webp,avif}',
  { caseSensitive: false },
);
const OPTIMISABLE = /\.(jpe?g|png|webp|avif)$/i;

let image: ImageMetadata | undefined;
let devOriginal = false;
if (src.startsWith('/images/') && OPTIMISABLE.test(src)) {
  const key = `/public${src}`;
  const load = PUBLIC_IMAGES[key];
  if (load) {
    image = (await load()).default;
  } else if (IS_ASTRO_DEV && existsInPublic(src)) {
    // Dev only (MODE, see IS_ASTRO_DEV): a build must keep the strict error.
    devOriginal = true;
  } else {
    throw new Error(
      `CmsImage: "${src}" names a local image, but no file matches ${key}. ` +
        `Check the content value (paths are exact and case-sensitive).`,
    );
  }
}

// --- the stored focal point and crop ---------------------------------------
const stored = src.startsWith('/images/') ? imageMetadata(src) : { focalPoint: null, crop: null };
let focalPoint = applyFocalPoint ? stored.focalPoint : null;
let crop = image ? stored.crop : null; // a plain <img> cannot crop
let cropBox: { left: number; top: number; width: number; height: number } | undefined;
if (image && crop) {
  if (imageConfig.service.entrypoint !== CROP_SERVICE) {
    if (!IS_ASTRO_DEV) {
      throw new Error(
        `CmsImage: "${src}" has a crop stored in public/images/.metadata.json, but the site's image ` +
          `service cannot apply it. Add image: { service: { entrypoint: '${CROP_SERVICE}' } } to ` +
          `astro.config.mjs, or clear the crop in the admin.`,
      );
    }
    crop = null; // dev: the preview shows the photo uncropped rather than nothing
  } else {
    cropBox = cropPixels(crop, image.width, image.height);
    if (focalPoint) {
      const clamp = (value: number) => Math.min(100, Math.max(0, value));
      focalPoint = {
        x: clamp(((focalPoint.x - crop.x) / crop.width) * 100),
        y: clamp(((focalPoint.y - crop.y) / crop.height) * 100),
      };
    }
  }
}

/** A CSS percentage: at most two decimals, no trailing zeros. */
const percent = (value: number) => `${Math.round(value * 100) / 100}%`;
const objectPosition = focalPoint ? `${percent(focalPoint.x)} ${percent(focalPoint.y)}` : undefined;
/** The site's `style` with `object-position` merged after it, in the shape it came in. */
function withObjectPosition(style: unknown, position: string): unknown {
  const declaration = `object-position: ${position}`;
  if (typeof style === 'string') {
    const base = style.trim().replace(/;+\s*$/, '');
    return base ? `${base}; ${declaration}` : declaration;
  }
  if (Array.isArray(style) && style.length === 2) {
    // Astro's [object, string] form: the string part is rendered last.
    return [style[0], withObjectPosition(style[1], position)];
  }
  if (typeof style === 'object' && style !== null) {
    const { objectPosition: _camel, 'object-position': _kebab, ...others } = style as Record<string, unknown>;
    return { ...others, 'object-position': position };
  }
  return declaration;
}
// With no point the attributes are `rest` itself: no style is added or moved.
const imgAttributes = objectPosition ? { ...rest, style: withObjectPosition(rest.style, objectPosition) } : rest;

const sourceWidth = cropBox ? cropBox.width : image ? image.width : 0;
const sourceHeight = cropBox ? cropBox.height : image ? image.height : 0;
const largestCandidate = Math.max(...candidateWidths);
const widths = image
  ? [
      ...new Set([
        ...candidateWidths.filter((width) => width < sourceWidth),
        ...(sourceWidth <= largestCandidate ? [sourceWidth] : []),
      ]),
    ].sort((a, b) => a - b)
  : [];
const fallbackWidth = image ? Math.min(sourceWidth, fallbackMaxWidth) : 0;
const fallbackHeight = image ? Math.round((sourceHeight * fallbackWidth) / sourceWidth) : 0;
---

{
  !src ? null : image ? (
    <Picture
      src={image}
      alt={alt}
      formats={SOURCE_FORMATS}
      fallbackFormat={fallbackFormat}
      widths={widths}
      sizes={sizes}
      width={fallbackWidth}
      height={fallbackHeight}
      {...(quality === undefined ? {} : { quality })}
      {...(crop ? { crop } : {})}
      {...imgAttributes}
    />
  ) : (
    <img src={withBase(src)} alt={alt} data-cms-image={devOriginal ? 'dev-original' : undefined} {...imgAttributes} />
  )
}
