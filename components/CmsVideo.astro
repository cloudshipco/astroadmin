---
/**
 * CmsVideo: renders a CMS video string (a `/images/...` .mp4 or .webm path
 * that a video field stores) as a muted, looping background video, the
 * counterpart to CmsImage. See docs/videos.md.
 *
 * - `<video muted loop playsinline preload="metadata">`: `muted` and
 *   `playsinline` are both needed for iOS to play it inline without a tap.
 * - Playback is started by the component's script (cms-video-client.js,
 *   loaded as its own file so a `script-src 'self'` CSP allows it), not the `autoplay`
 *   attribute, so that under `prefers-reduced-motion: reduce` nothing moves:
 *   the poster shows alone until the visitor presses Play. Without script the
 *   poster shows and the browser's own controls stay off.
 * - A pause/play button is part of the component (WCAG 2.2.2: motion longer
 *   than five seconds must be pausable), hidden until the script wires it.
 *   Its styles are `:where()` rules in the `components` cascade layer, so a
 *   site's unlayered rules and its utilities (Tailwind v4's `utilities`
 *   layer) override them. Its look is on `.cms-video-toggle-face`; set
 *   `--cms-video-toggle-background` and `--cms-video-toggle-color` to
 *   restyle it, or position `.cms-video-toggle`.
 * - `poster`: a `/images/...` raster path is optimised through Astro's image
 *   pipeline (one WebP at up to `posterWidth`), as CmsImage optimises its
 *   images; an external URL or SVG is used as is.
 * - A local `/images/` video or poster with no file under public/ fails the
 *   build with an error naming the content value (exact case). A video is
 *   found on disk in the site's public/ (site-files.js), in a build and in
 *   dev alike, so it is never bundled a second time (#90). In `astro dev`
 *   (MODE, as CmsImage) a poster uploaded after start is used as the
 *   original.
 * - A local path (`/images/...`) is served under the site's `base`
 *   (`/blog/images/...` with `base: '/blog'`); the stored value is not.
 * - `class` and every other attribute (data-aa-field...) go on the <video>;
 *   `wrapperClass` goes on the wrapping element, which positions the button.
 * - Empty `src`: nothing. A value that is not a root-relative path or http(s)
 *   URL of an .mp4/.webm file (a bare name, a YouTube page) fails the build.
 *
 * A site that sets a Content-Security-Policy needs `media-src 'self'` (or
 * wherever its videos are served from); the script is a same-origin file, so
 * `script-src 'self'` allows it.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { existsInPublic, existsInPublicExactCase, withBase } from './site-files.js';
// The browser script as a file of its own (see cms-video-client.js): `?url`
// emits it unprocessed and `no-inline` keeps Vite from turning a small one
// into a data: URL. Either an inline script or a data: URL is blocked by a
// site's `script-src 'self'`.
import clientScriptUrl from './cms-video-client.js?url&no-inline';

interface Props {
  src?: string;
  /** A still shown before the video plays, and instead of it under reduced motion. */
  poster?: string;
  /** Largest width the poster is generated at. */
  posterWidth?: number;
  /** What the video shows, for the button's label: "Pause <label>". */
  label?: string;
  /** Class on the wrapping element (the button is positioned inside it). */
  wrapperClass?: string;
  [attr: string]: unknown;
}

const {
  src = '',
  poster = '',
  posterWidth = 1920,
  label = 'background video',
  wrapperClass,
  ...rest
} = Astro.props;

const IS_ASTRO_DEV = import.meta.env.MODE === 'development';

// A video is looked up on disk (site-files.js), never through a glob: each
// glob entry is a module importing its file, so Vite emitted every video a
// second time under _astro/ beside the copy public/ serves (#90). The
// poster glob is loaded only for a rendered poster, which Astro's image
// pipeline optimises. Vite resolves it against the site's root.
const PUBLIC_IMAGES = import.meta.glob<{ default: ImageMetadata }>(
  '/public/images/**/*.{jpg,jpeg,png,webp,avif}',
  { caseSensitive: false },
);
const OPTIMISABLE = /\.(jpe?g|png|webp|avif)$/i;

function missing(kind: string, value: string): Error {
  return new Error(
    `CmsVideo: ${kind} "${value}" names a local file, but no file matches /public${value}. ` +
      `Check the content value (paths are exact and case-sensitive).`,
  );
}

// What the editor's video box can hold besides a library path: a typed bare
// name (served relative to each page, so broken on nested ones) or a link to
// a page (a YouTube watch URL) that no <video> can play. Either is a content
// error the build reports, as it does a missing file.
const VIDEO_FILE = /^(?:\/(?!\/)|https?:\/\/)[^?#]*\.(?:mp4|webm)(?:[?#]|$)/i;
if (src && !VIDEO_FILE.test(src)) {
  throw new Error(
    `CmsVideo: "${src}" is not an MP4 or WebM file. ` +
      `Choose a video from the library (a /images/... path) or give the URL of an .mp4 or .webm file.`,
  );
}

// Exact case, as the deployed (case-sensitive) server serves it, also in dev.
if (src.startsWith('/images/') && !existsInPublicExactCase(src)) {
  throw missing('video', src);
}

let posterUrl = poster;
if (poster.startsWith('/images/') && OPTIMISABLE.test(poster)) {
  const load = PUBLIC_IMAGES[`/public${poster}`];
  if (load) {
    const image = (await load()).default;
    const still = await getImage({ src: image, width: Math.min(image.width, posterWidth), format: 'webp', quality: 80 });
    posterUrl = still.src; // Astro's own URL, base included
  } else if (!(IS_ASTRO_DEV && existsInPublic(poster))) {
    throw missing('poster', poster);
  } else {
    posterUrl = withBase(poster);
  }
} else {
  posterUrl = withBase(poster);
}

const srcPath = src.split(/[?#]/)[0];
const type = /\.webm$/i.test(srcPath) ? 'video/webm' : /\.mp4$/i.test(srcPath) ? 'video/mp4' : undefined;
---

{
  src && (
    <div class:list={['cms-video', wrapperClass]} data-cms-video>
      <video muted loop playsinline preload="metadata" poster={posterUrl || undefined} {...rest}>
        <source src={withBase(src)} type={type} />
      </video>
      <button type="button" class="cms-video-toggle" data-cms-video-toggle data-label={label} aria-label={`Play ${label}`} hidden>
        <span class="cms-video-toggle-face" aria-hidden="true" data-cms-video-icon>▶</span>
      </button>
      <script is:inline type="module" src={clientScriptUrl}></script>
    </div>
  )
}

<style is:global>
  /* In the `components` layer, not unlayered: unlayered CSS beats every
     layer whatever its specificity, so these defaults would override a
     layered site's utilities (Tailwind v4's wrapperClass="absolute inset-0").
     Where the site's layer order statement comes first (Astro puts a site's
     own CSS before a package component's), Tailwind v4 orders `components`
     below `utilities`; where it comes later, `components` is the lowest
     layer, still below utilities. The button's look is on its inner face,
     not the <button>: a reset (Tailwind's preflight strips every button's
     background and radius) would otherwise win in the second order. Restyle
     it with the two custom properties, which no layer order can undo. */
  @layer components {
    :where(.cms-video) {
      position: relative;
    }
    :where(.cms-video > video) {
      display: block;
      width: 100%;
    }
    :where(.cms-video-toggle) {
      position: absolute;
      right: 0.75rem;
      bottom: 0.75rem;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      cursor: pointer;
    }
    :where(.cms-video-toggle-face) {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      border-radius: 999px;
      background: var(--cms-video-toggle-background, rgb(0 0 0 / 0.6));
      color: var(--cms-video-toggle-color, #fff);
    }
    :where(.cms-video-toggle:focus-visible) {
      outline: 2px solid #fff;
      outline-offset: 2px;
    }
  }
</style>

